# ==============================================================================
# Server
# ==============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ==============================================================================
# Webhook security
# Shared secret TradingView must send back so random bots can't hit the
# endpoint and place orders. Send it as header "x-webhook-secret" OR as
# query string "?token=..." on the alert URL (TradingView cannot set custom
# headers on webhook alerts, so the query-string form is what you'll use
# in practice). Leave unset only for local testing.
# ==============================================================================
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ==============================================================================
# Admin dashboard (auto-trading-frontend)
# ADMIN_PASSWORD must match the password configured in the frontend's env
# (sent as header "x-admin-password" on every /api/* request).
# ADMIN_ALLOWED_ORIGIN is the frontend's deployed origin, for CORS
# (e.g. https://your-admin-panel.vercel.app). Leave unset to allow any origin.
# ==============================================================================
ADMIN_PASSWORD=change-me-to-a-long-random-string
ADMIN_ALLOWED_ORIGIN=

# ==============================================================================
# Supabase (PostgreSQL) — run sql/schema.sql against this project first
# ==============================================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key (NOT the anon key) — this server runs with elevated
# trusted privileges and must be able to write to every table. Never expose
# this key to a browser/client.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ==============================================================================
# Upstox Sandbox API
# Confirmed by hitting the endpoint directly: api-sandbox.upstox.com is a real,
# distinct host from api.upstox.com (live) and responds with sandbox-specific
# auth errors. The access token must come from a SANDBOX APP specifically —
# account.upstox.com/developer/apps#sandbox -> "New Sandbox App" -> Generate.
# A token generated from a regular/live app will be rejected here even if
# valid on api.upstox.com.
# ==============================================================================
UPSTOX_API_BASE_URL=https://api-sandbox.upstox.com/v2
UPSTOX_SANDBOX_ACCESS_TOKEN=your-upstox-sandbox-access-token

# ==============================================================================
# LIVE TRADING (mode = "live")
# ==============================================================================
# Everything below is OPTIONAL. With none of it set the live environment
# reports "not configured", refuses every order, and paper carries on exactly
# as it does today. That is deliberate: live can be half-built for weeks
# without paper noticing. See docs/GO_LIVE.md.
#
# BEFORE ANY OF THIS MATTERS you need a STATIC IP registered with Upstox.
# SEBI's mandate has been enforced since 1 Apr 2026 and every order from an
# unregistered IP is rejected. Production runs on a DigitalOcean droplet whose
# outbound IP (64.227.153.201) is the registered primary — see docs/GO_LIVE.md §1.

# Master switch for the whole live environment. Separate from the per-mode kill
# switch on the Settings page — BOTH must be on before a real order goes out.
# Leave false until the static IP and the daily token flow are both proven.
LIVE_TRADING_ENABLED=false

# From the Upstox developer console (My Apps). The redirect URI must match the
# one registered there EXACTLY, and must point at this server:
#   https://<your-server>/api/upstox/callback
#   (production: https://139-59-52-230.sslip.io/api/upstox/callback)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=

# The Algo App's NAME (not its ID). Upstox requires it as the X-Algo-Name
# header on live order placement once the app is registered as an algo.
UPSTOX_ALGO_NAME=

# Live hosts. Overridable because Upstox's own docs disagree: the place-order
# page documents api-hft.upstox.com while the overview page does not mention
# it. Confirm against your account before the first live order — see
# docs/GO_LIVE.md section 3.1.
UPSTOX_LIVE_ORDER_BASE_URL=https://api-hft.upstox.com/v2
UPSTOX_LIVE_API_BASE_URL=https://api.upstox.com/v2

# NOTE: there is deliberately NO live access token here. It expires at 03:30
# IST every single day, so it lives in the broker_tokens table where a running
# server can pick up a fresh one without a redeploy. Mint it from
# Settings -> Upstox connection.

# ==============================================================================
# Order defaults
# TradingView alerts in this bridge do NOT know the exact Upstox
# instrument_token for the current weekly option contract (that changes
# every expiry/strike). Prefer sending instrument_token/quantity directly
# in the alert JSON. These are only a fallback for quick local testing.
# ==============================================================================
DEFAULT_INSTRUMENT_TOKEN=
DEFAULT_QUANTITY=
DEFAULT_PRODUCT=I
DEFAULT_ORDER_TYPE=MARKET

# ==============================================================================
# Kill switch
# Primary control is the `app_config.trading_enabled` row in Supabase (can be
# flipped without redeploying). TRADING_ENABLED is only the fallback used if
# the Supabase read itself fails, so the bridge fails "paused", not "open".
# ==============================================================================
TRADING_ENABLED=true

# ==============================================================================
# Duplicate-prevention tuning
# ==============================================================================
DUPLICATE_WINDOW_SECONDS=30

# ==============================================================================
# Intraday session rules — ALL IST (NSE trades in Asia/Kolkata).
# Enforced server-side, independent of the Pine script, because Pine can only
# act when a bar closes: if its exit condition is never met the position would
# otherwise stay open indefinitely. Two positions were carried overnight during
# the 6-12 Aug 2026 paper run, one across a whole weekend, for exactly this
# reason.
#
# ENTRY_CUTOFF_IST  no NEW position may be opened at/after this time.
# SQUARE_OFF_IST    anything still open at/after this is force-closed. Kept 5
#                   minutes later than the Pine script's own 15:15 square-off,
#                   so in normal operation Pine closes first and this is only
#                   the safety net (no duplicate exit to reject).
# ==============================================================================
MARKET_OPEN_IST=09:15
MARKET_CLOSE_IST=15:30
ENTRY_CUTOFF_IST=14:45
SQUARE_OFF_IST=15:20
SQUARE_OFF_ENABLED=true
SQUARE_OFF_POLL_SECONDS=60
TZ=Asia/Kolkata
# ==============================================================================
# Paper-fill pricing
# The Upstox SANDBOX never executes anything — every order placed sits at
# status "open pending" with average_price 0 and filled_quantity 0 forever.
# So P&L cannot come from broker fills; it is marked against the option's real
# traded price from Upstox's public 1-minute candles instead.
#
# PAPER_SLIPPAGE_POINTS is the bid-ask allowance charged AGAINST you on both
# legs. On BANKNIFTY monthly ATM, 1.5 points at 30 qty is ~Rs.90 per round trip
# — over 24 trades that was more than half the total loss, so do not set this
# to 0 unless you specifically want to see gross, pre-cost numbers.
# ==============================================================================
PAPER_SLIPPAGE_POINTS=1.5

# ==============================================================================
# Premium-based exit rules (src/services/positionMonitor.js)
#
# The Pine score cannot book a profit. It is EMA/Supertrend/MACD on the INDEX,
# so an exit only fires once the trend measure has decayed — by which time the
# option premium has peaked and round-tripped. Over 13-14 Aug 2026, 10 of 12
# trades were in profit at some point and Rs.11,064 was handed back waiting for
# the score. Trade 51 was +Rs.1,656 at 12 minutes and closed at -Rs.18 at 60.
#
# These rules watch the PREMIUM instead and act on it:
#   STOP_LOSS_PCT   hard stop, fraction below entry premium
#   TRAIL_ARM_PCT   trailing stop stays off until this far in profit
#   TRAIL_PCT       once armed, exit on this much retrace from the peak
#   MAX_HOLD_MINUTES give up on a position going nowhere (0 = off)
#
# Backtested conservatively (1-minute closes, the resolution a poller can act
# on) over all 37 trades from 6-14 Aug: score-based exits gave -Rs.13,061;
# these defaults give -Rs.7,612. EVERY combination tested beat the score-based
# exit, so this is not a cherry-picked row.
#
# This bounds the damage. It does NOT make the strategy profitable — the entry
# signal has negative edge and no exit rule fixes a bad entry.
# ==============================================================================
EXIT_RULES_ENABLED=true
STOP_LOSS_PCT=0.10
TRAIL_ARM_PCT=0.03
TRAIL_PCT=0.05
MAX_HOLD_MINUTES=30
EXIT_POLL_SECONDS=30

# After a stop-loss/trailing/time exit, refuse a SAME-DIRECTION re-entry for
# this long. The Pine script re-sends its entry every few bars while the bias
# holds (so it stays in step after a server exit it cannot see) — without this
# it would walk straight back into the trade the stop just closed, repeatedly.
# A reversal to the other side is still allowed immediately.
RE_ENTRY_COOLDOWN_MINUTES=15

# ==============================================================================
# Daily trade cap (0 = off)
#
# The single most robust rule in the dataset, and the only one that cannot be
# wrong even if every pattern we think we see is noise. Both independent
# measurements say per-trade expectancy is NEGATIVE (-Rs.155/trade live over 57
# trades; -17.84/trade in TradingView own Feb-Aug backtest, profit factor
# 0.516). With negative expectancy, fewer trades is better arithmetically.
#
# The effect is monotonic in BOTH measurement windows:
#                     6-21 Aug (57)     17-21 Aug (20)
#   no cap              -Rs.8,859         +Rs.4,202
#   max 3/day           -Rs.4,545         +Rs.4,368
#   max 2/day           +Rs.  795         +Rs.5,459
#   max 1/day           +Rs.5,444         +Rs.7,770
#
# 2 rather than 1: 1/day is the extreme end of the sweep (most likely over-fit)
# and yields only ~20 trades a month to learn from.
#
# Stopping the day after a WIN is done MANUALLY from the dashboard kill switch,
# not here. It measures the same (+Rs.3,116 / +Rs.6,777) and keeping it manual
# leaves a human deciding when the day is done.
# ==============================================================================
MAX_TRADES_PER_DAY=2

# ==============================================================================
# ATM contract auto-resolution
# ==============================================================================
STRIKE_INTERVAL=100
INSTRUMENT_MASTER_CACHE_TTL_MS=21600000

# ==============================================================================
# Upstox call retry tuning
# ==============================================================================
UPSTOX_MAX_RETRIES=2
UPSTOX_RETRY_BASE_DELAY_MS=500
