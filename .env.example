# ==============================================================================
# Server
# ==============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ==============================================================================
# Webhook security
# Shared secret TradingView must send back so random bots can't hit the
# endpoint and place orders. Send it as header "x-webhook-secret" OR as
# query string "?token=..." on the alert URL (TradingView cannot set custom
# headers on webhook alerts, so the query-string form is what you'll use
# in practice). Leave unset only for local testing.
# ==============================================================================
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ==============================================================================
# Admin dashboard (auto-trading-frontend)
# ADMIN_PASSWORD must match the password configured in the frontend's env
# (sent as header "x-admin-password" on every /api/* request).
# ADMIN_ALLOWED_ORIGIN is the frontend's deployed origin, for CORS
# (e.g. https://your-admin-panel.vercel.app). Leave unset to allow any origin.
# ==============================================================================
ADMIN_PASSWORD=change-me-to-a-long-random-string
ADMIN_ALLOWED_ORIGIN=

# ==============================================================================
# Supabase (PostgreSQL) — run sql/schema.sql against this project first
# ==============================================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Service role key (NOT the anon key) — this server runs with elevated
# trusted privileges and must be able to write to every table. Never expose
# this key to a browser/client.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ==============================================================================
# Upstox Sandbox API
# Confirmed by hitting the endpoint directly: api-sandbox.upstox.com is a real,
# distinct host from api.upstox.com (live) and responds with sandbox-specific
# auth errors. The access token must come from a SANDBOX APP specifically —
# account.upstox.com/developer/apps#sandbox -> "New Sandbox App" -> Generate.
# A token generated from a regular/live app will be rejected here even if
# valid on api.upstox.com.
# ==============================================================================
UPSTOX_API_BASE_URL=https://api-sandbox.upstox.com/v2
UPSTOX_SANDBOX_ACCESS_TOKEN=your-upstox-sandbox-access-token

# ==============================================================================
# Order defaults
# TradingView alerts in this bridge do NOT know the exact Upstox
# instrument_token for the current weekly option contract (that changes
# every expiry/strike). Prefer sending instrument_token/quantity directly
# in the alert JSON. These are only a fallback for quick local testing.
# ==============================================================================
DEFAULT_INSTRUMENT_TOKEN=
DEFAULT_QUANTITY=
DEFAULT_PRODUCT=I
DEFAULT_ORDER_TYPE=MARKET

# ==============================================================================
# Kill switch
# Primary control is the `app_config.trading_enabled` row in Supabase (can be
# flipped without redeploying). TRADING_ENABLED is only the fallback used if
# the Supabase read itself fails, so the bridge fails "paused", not "open".
# ==============================================================================
TRADING_ENABLED=true

# ==============================================================================
# Duplicate-prevention tuning
# ==============================================================================
DUPLICATE_WINDOW_SECONDS=30

# ==============================================================================
# Upstox call retry tuning
# ==============================================================================
UPSTOX_MAX_RETRIES=2
UPSTOX_RETRY_BASE_DELAY_MS=500
